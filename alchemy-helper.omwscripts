# Alchemist's Almanac - OpenMW Lua Mod
#
# Directory name: alchemy-helper
# Mod title:      Alchemist's Almanac
#
# The directory "alchemy-helper" is the internal project name;
# the mod appears to players as "Alchemist's Almanac".
#
# A general in-game reference for alchemy ingredients and their vendors.
# Provides a filterable ingredient list and a shopping planner for finding
# merchants that sell ingredients.
#
# Target: OpenMW 0.51+
# Dependency: OpenMW-UIToolkit (EnderWiggin/OpenMW-UIToolkit) installed as a
# sibling Data Files entry; without it the almanac UI is disabled.
# Optional: Inventory Extender — when installed, an "AA" button is mounted in
# its inventory info bar that opens/closes the almanac.

GLOBAL:                       scripts/alchemy-helper/init.lua
PLAYER:                       scripts/alchemy-helper/alchemy-binding.lua
NPC CREATURE CONTAINER INGREDIENT: scripts/alchemy-helper/ingredient-detect.lua
